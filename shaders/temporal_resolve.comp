#version 460
#extension GL_GOOGLE_include_directive : enable
#include "octahedral.glsl"

layout(local_size_x=8, local_size_y=8) in;

layout(rgba16f, binding = 0) uniform readonly image2D currImg;
layout(rgba16f, binding = 1) uniform readonly image2D prevImg;
layout(rgba16f, binding = 2) uniform writeonly image2D outImg;
// G-buffer slices: this frame's and last frame's. .x hit distance, .yz
// octahedral normal, .w instance ID.
layout(rgba16f, binding = 3) uniform readonly image2D gbufferCurr;
layout(rgba16f, binding = 4) uniform readonly image2D gbufferPrev;
layout(rgba16f, binding = 5) uniform readonly image2D motionImg;

layout(push_constant) uniform PC {
    float alpha;
    float clampK;          // history bound, in neighborhood standard deviations
    float depthTolerance;  // fraction of hit distance
    float normalTolerance; // minimum dot product between normals
    int debugView;         // 5 shows how much history each pixel reused
} pc;

// History at q describes the same surface as the current pixel's geometry.
bool history_matches(vec4 g, ivec2 q)
{
    vec4 gPrev = imageLoad(gbufferPrev, q);

    // The environment map depends only on ray direction, so a sky pixel that
    // reprojects onto sky is always a valid match.
    if (g.x <= 0.0 || gPrev.x <= 0.0) {
        return (g.x <= 0.0) == (gPrev.x <= 0.0);
    }

    return int(g.w) == int(gPrev.w)
        && abs(g.x - gPrev.x) <= pc.depthTolerance * g.x
        && dot(oct_decode(g.yz), oct_decode(gPrev.yz)) >= pc.normalTolerance;
}

void main()
{
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(currImg);
    if (p.x >= size.x || p.y >= size.y) {
        return;
    }

    vec3 c = imageLoad(currImg, p).rgb;

    // Bounds for history, from the mean and standard deviation of the 3x3
    // neighborhood. A fixed offset would have to be wide enough for the brightest
    // parts of the image, which leaves it far wider than the signal in shadow,
    // where radiance is a few hundredths and stale history is most visible.
    vec3 m1 = vec3(0.0), m2 = vec3(0.0);
    for (int dy=-1; dy<=1; ++dy)
    for (int dx=-1; dx<=1; ++dx) {
        vec3 s = imageLoad(currImg, clamp(p + ivec2(dx,dy), ivec2(0), size - 1)).rgb;
        m1 += s; m2 += s * s;
    }
    vec3 mu = m1 / 9.0;
    vec3 sigma = sqrt(max(m2 / 9.0 - mu * mu, vec3(0.0)));

    // Bilinear history fetch. Reprojection lands between texels, and taking the
    // nearest one instead resamples the whole history by a whole texel every
    // frame, which drags noise along the direction of travel into streaks.
    vec2 hp = vec2(p) + imageLoad(motionImg, p).xy;
    ivec2 base = ivec2(floor(hp));
    vec2 f = hp - vec2(base);

    const ivec2 offsets[4] = ivec2[4](ivec2(0, 0), ivec2(1, 0), ivec2(0, 1), ivec2(1, 1));
    vec4 bilinear = vec4((1.0 - f.x) * (1.0 - f.y), f.x * (1.0 - f.y), (1.0 - f.x) * f.y, f.x * f.y);

    // Each tap is kept or dropped on its own, so a pixel straddling a silhouette
    // keeps the part of its history that still describes the same surface instead
    // of falling back to a single sample.
    vec4 g = imageLoad(gbufferCurr, p);
    vec3 h = vec3(0.0);
    float valid = 0.0;
    for (int i = 0; i < 4; ++i) {
        ivec2 q = base + offsets[i];
        if (all(greaterThanEqual(q, ivec2(0))) && all(lessThan(q, size)) && history_matches(g, q)) {
            h += imageLoad(prevImg, q).rgb * bilinear[i];
            valid += bilinear[i];
        }
    }

    float weight = pc.alpha * valid;
    if (valid > 0.0) {
        h /= valid;
    }
    vec3 hc = clamp(h, mu - pc.clampK * sigma, mu + pc.clampK * sigma);

    // Red in proportion to how much of the history the pixel threw away, over a
    // dimmed copy of the scene for context. Reuse is decided by geometry alone,
    // so overwriting the color here does not change which pixels light up on
    // later frames.
    if (pc.debugView == 5) {
        imageStore(outImg, p, vec4(max(c.r * 0.25, 1.0 - valid), c.gb * 0.25, 1));
        return;
    }

    imageStore(outImg, p, vec4(mix(c, hc, weight), 1));
}

#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_GOOGLE_include_directive : enable
#include "raycommon.glsl"

layout(set = 0, binding = 0) uniform accelerationStructureEXT topLevelAS;
layout(set = 0, binding = 1, rgba32f) uniform image2D image;
// Slice counts match RtEngine::kGbufferSlices and FRAME_OVERLAP.
layout(set = 0, binding = 3, rgba16f) uniform image2D gbuffer[3];
layout(set = 0, binding = 4, rgba16f) uniform image2D motionImage[2];

layout(location = 0) rayPayloadEXT hitPayload prd;

vec2 halton2(uint n){
    float h2=0.0,f2=0.5; uint i=n+1u;
    for(; i>0u; i/=2u){ h2 += f2*float(i%2u); f2*=0.5; }
    float h3=0.0,f3=1.0/3.0; i=n+1u;
    for(; i>0u; i/=3u){ h3 += f3*float(i%3u); f3*=1.0/3.0; }
    return vec2(h2,h3);
}

// Visualizes what reprojection reads, so a wrong G-buffer is visible rather than
// only showing up as temporal artifacts. Modes match RtEngine::_debugView. Every
// mode paints a miss black, since none of these quantities exist for the sky.
vec3 debug_color(int mode, vec2 motion)
{
    // Normal, remapped from [-1,1] to [0,1]. A correct frame is flat per face:
    // green floor, magenta ceiling, opposing walls in complementary colors.
    if (mode == 1) {
        return prd.hitT > 0.0 ? prd.worldNormal * 0.5 + 0.5 : vec3(0.0);
    }
    // Hit distance on a log scale, so near geometry keeps contrast. White at 63 units.
    if (mode == 2) {
        return prd.hitT > 0.0 ? vec3(log2(prd.hitT + 1.0) / 6.0) : vec3(0.0);
    }
    // Motion in pixels: red horizontal, green vertical, saturating at 16. Centers on
    // olive because zero motion maps to 0.5. A still camera should be flat olive
    // everywhere; any structure there means the reprojection round trip is off.
    if (mode == 3) {
        return vec3(motion / 16.0 * 0.5 + 0.5, 0.0);
    }
    // Instance ID hashed to a color, so neighboring instances land on unrelated
    // colors. Flat blocks per object; speckle would mean the ID is not stable.
    if (mode == 4) {
        uint h = pcg_hash(uint(prd.instanceID + 1));
        return prd.hitT > 0.0
            ? vec3(uint_to_unit_float(h), uint_to_unit_float(pcg_hash(h)), uint_to_unit_float(pcg_hash(h + 1u)))
            : vec3(0.0);
    }
    return prd.hitValue;
}

void main()
{
    uint frame = uint(sceneData.data.x);
    ivec2 pix = ivec2(gl_LaunchIDEXT.xy);
    vec2 res = vec2(gl_LaunchSizeEXT.xy);

    // 1 spp with low-discrepancy jitter
    vec2 jitter = halton2(frame) - 0.5;
    vec2 uv = (vec2(pix) + jitter) / res;
    vec2 ndc = uv * 2.0 - 1.0;

    vec4 o = sceneData.invView * vec4(0,0,0,1);
    vec4 t = sceneData.invProj * vec4(ndc,1,1);
    vec4 d = sceneData.invView * vec4(normalize(t.xyz),0);

    prd.recursionDepth = 0;
    prd.hitT = -1.0;
    prd.worldNormal = vec3(0.0);
    prd.instanceID = -1;
    traceRayEXT(topLevelAS, gl_RayFlagsOpaqueEXT, 0xFF, 0,0,0, o.xyz, 0.001, d.xyz, 10000.0, 0);

    // How far this surface moved on screen since last frame, in pixels. The hit
    // came from the jittered ray, so subtracting the jittered position is what
    // makes a static camera give zero. A miss reprojects as a far-plane point.
    vec2 motion = vec2(0.0);
    float reprojectT = prd.hitT > 0.0 ? prd.hitT : 10000.0;
    vec4 clipPrev = sceneData.prevViewProj * vec4(o.xyz + d.xyz * reprojectT, 1.0);
    if (clipPrev.w > 0.0) {
        motion = (clipPrev.xy / clipPrev.w * 0.5 + 0.5) * res - (vec2(pix) + jitter);
    }

    imageStore(gbuffer[int(sceneData.data.z)], pix,
               vec4(prd.hitT, oct_encode(prd.worldNormal), float(prd.instanceID)));
    imageStore(motionImage[int(sceneData.data.x) % 2], pix, vec4(motion, 0, 0));

    imageStore(image, pix, vec4(debug_color(int(sceneData.data.w), motion), 1));
}

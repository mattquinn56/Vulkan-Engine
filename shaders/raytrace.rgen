#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_GOOGLE_include_directive : enable
#include "raycommon.glsl"

layout(set = 0, binding = 0) uniform accelerationStructureEXT topLevelAS;
layout(set = 0, binding = 1, rgba32f) uniform image2D image;
// Two slices so the previous frame's geometry survives for reprojection.
layout(set = 0, binding = 3, rgba32f) uniform image2D gbuffer[2];
layout(set = 0, binding = 4, rg32f) uniform image2D motionImage;

layout(location = 0) rayPayloadEXT hitPayload prd;

vec2 halton2(uint n){
    float h2=0.0,f2=0.5; uint i=n+1u;
    for(; i>0u; i/=2u){ h2 += f2*float(i%2u); f2*=0.5; }
    float h3=0.0,f3=1.0/3.0; i=n+1u;
    for(; i>0u; i/=3u){ h3 += f3*float(i%3u); f3*=1.0/3.0; }
    return vec2(h2,h3);
}

vec3 debug_color(int mode, vec2 motion)
{
    if (mode == 1) {
        return prd.hitT > 0.0 ? prd.worldNormal * 0.5 + 0.5 : vec3(0.0);
    }
    if (mode == 2) {
        // Log scale so near geometry keeps contrast; white at 63 units out.
        return prd.hitT > 0.0 ? vec3(log2(prd.hitT + 1.0) / 6.0) : vec3(0.0);
    }
    if (mode == 3) {
        // Red is horizontal, green vertical; 16 pixels of motion saturates.
        return vec3(motion / 16.0 * 0.5 + 0.5, 0.0);
    }
    if (mode == 4) {
        uint h = pcg_hash(uint(prd.instanceID + 1));
        return prd.hitT > 0.0
            ? vec3(uint_to_unit_float(h), uint_to_unit_float(pcg_hash(h)), uint_to_unit_float(pcg_hash(h + 1u)))
            : vec3(0.0);
    }
    return prd.hitValue;
}

void main()
{
    uint frame = uint(sceneData.data.x);
    ivec2 pix = ivec2(gl_LaunchIDEXT.xy);
    vec2 res = vec2(gl_LaunchSizeEXT.xy);

    // 1 spp with low-discrepancy jitter
    vec2 uv = (vec2(pix) + halton2(frame) - 0.5) / res;
    vec2 ndc = uv * 2.0 - 1.0;

    vec4 o = sceneData.invView * vec4(0,0,0,1);
    vec4 t = sceneData.invProj * vec4(ndc,1,1);
    vec4 d = sceneData.invView * vec4(normalize(t.xyz),0);

    prd.recursionDepth = 0;
    prd.hitT = -1.0;
    prd.worldNormal = vec3(0.0);
    prd.instanceID = -1;
    traceRayEXT(topLevelAS, gl_RayFlagsOpaqueEXT, 0xFF, 0,0,0, o.xyz, 0.001, d.xyz, 10000.0, 0);

    // Where this surface sat in the previous frame's projection, in pixels.
    // Measured against the unjittered pixel so the jitter does not leak in.
    vec2 motion = vec2(0.0);
    if (prd.hitT > 0.0) {
        vec4 clipPrev = sceneData.prevViewProj * vec4(o.xyz + d.xyz * prd.hitT, 1.0);
        if (clipPrev.w > 0.0) {
            motion = (clipPrev.xy / clipPrev.w * 0.5 + 0.5) * res - vec2(pix);
        }
    }

    imageStore(gbuffer[int(sceneData.data.z)], pix,
               vec4(prd.hitT, oct_encode(prd.worldNormal), float(prd.instanceID)));
    imageStore(motionImage, pix, vec4(motion, 0, 0));

    imageStore(image, pix, vec4(debug_color(int(sceneData.data.w), motion), 1));
}

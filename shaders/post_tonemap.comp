#version 460
#extension GL_EXT_nonuniform_qualifier : enable

layout (local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba32f) uniform readonly image2D uHDR;
layout(set = 0, binding = 1, rgba16f) uniform writeonly image2D uLDR;

layout(push_constant) uniform PC {
    float exposure;   // 1.0 = neutral
} pc;

// ACES fitted tone map (Narkowicz)
vec3 RRTAndODTFit(vec3 v)
{
    vec3 a = v * (v + 0.0245786) - 0.000090537;
    vec3 b = v * (0.983729 * v + 0.4329510) + 0.238081;
    return a / b;
}

vec3 ACESFitted(vec3 color)
{
    // IMPORTANT: column-major! Each column is a vec3.
    const mat3 ACESInputMat = mat3(
        0.59719, 0.07600, 0.02840,
        0.35458, 0.90834, 0.13383,
        0.04823, 0.01566, 0.83777
    );

    const mat3 ACESOutputMat = mat3(
         1.60475, -0.10208, -0.00327,
        -0.53108,  1.10813, -0.07276,
        -0.07367, -0.00605,  1.07602
    );

    color = ACESInputMat * color;
    color = RRTAndODTFit(color);
    color = ACESOutputMat * color;

    return clamp(color, 0.0, 1.0);
}

// Linear -> sRGB (OETF)
vec3 linear_to_srgb(vec3 x)
{
    x = max(x, vec3(0.0));
    bvec3 cut = lessThan(x, vec3(0.0031308));
    vec3 low  = 12.92 * x;
    vec3 high = 1.055 * pow(x, vec3(1.0/2.4)) - 0.055;
    return mix(high, low, cut);
}

void main()
{
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    vec4 hdr = imageLoad(uHDR, px);          // linear HDR in [0, +inf)

    // Exposure: 1.0 = neutral
    const float exposure = 1.0;
    vec3 mapped = ACESFitted(hdr.rgb * pc.exposure);

    // sRGB encode for the swapchain
    vec3 srgb = linear_to_srgb(mapped);

    imageStore(uLDR, px, vec4(srgb, 1.0));
}
